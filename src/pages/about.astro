---
import { Image } from 'astro:assets';
import ryan from '../assets/ryan.jpg';
import Section from '../components/Section.astro';
import { PDW, SITE_AUTHOR, SITE_LOCATION, SOCIAL } from '../consts';
import Base from '../layouts/Base.astro';
import { personSchema } from '../lib/schema';

const title = 'About Ryan Roga · Roga Digital';
const description =
	'Roga Digital is the software studio of Ryan Roga, a developer on Vancouver Island, BC, who ran a business before building internal tools, dashboards, and integrations for them.';

const jsonLd = personSchema(Astro.site, 'Lead Full-Stack Product Developer');

const stack = [
	'TypeScript',
	'SvelteKit · Svelte 5',
	'Astro',
	'Node.js · Express',
	'Python',
	'Postgres',
	'Vercel · Railway',
	'Tailwind CSS',
	'OpenAI · Anthropic',
	'Vitest',
	'Zod',
	'Prisma',
];

const principles = [
	{
		n: '01',
		h: 'A written read before any proposal.',
		b: "You tell me what you're working on. I send back a written summary of what I think you should and shouldn't build. If we go ahead, that summary becomes the starting scope.",
	},
	{
		n: '02',
		h: 'Working previews every week.',
		b: 'You see real, deployed progress every week, and your feedback shapes the build directly. Nobody sits between you and the person writing the code.',
	},
	{
		n: '03',
		h: 'Built to be inherited.',
		b: 'Every project ships with documentation, runbooks, and monitors. If you bring on your own developers later, they can read the code and ship the next feature without calling me.',
	},
	{
		n: '04',
		h: 'Support after launch.',
		b: 'A 30-day post-launch period is included by default. Many clients keep me on afterwards for audits, gradual rebuilds, and on-call for the things that matter.',
	},
];
---

<Base {title} {description} {jsonLd}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="grid gap-10 pt-16 pb-16 sm:pt-20 sm:pb-20 lg:grid-cols-12 lg:gap-16">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">About</p>
					<h1 class="mt-6 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-5xl">
						I ran a business before I built software for them.
					</h1>
					<div class="mt-6 max-w-2xl space-y-4 text-lg text-fg-muted text-pretty">
						<p>
							I&rsquo;m {SITE_AUTHOR}. Roga Digital is my software studio, based on {SITE_LOCATION}.
							I design, build, and maintain internal tools, dashboards, integrations, and AI
							features: the systems a company depends on every day and rarely has time to fix.
						</p>
						<p>
							Before this I spent years running a home-services business in Victoria, BC. The
							software I built in-house drove 100% of its leads and helped partner companies close
							30% more jobs. I know what it costs when a tool breaks at 5 pm on a Friday, so I build
							for the people who use the software, not only the people who asked for it.
						</p>
						<p>
							I founded Roga Digital in 2021, graduated top of class from Vancouver Island
							University&rsquo;s Web &amp; Mobile Application Development program in 2023, and have
							built full-time for clients in telecom, healthcare, education, and logistics since.
						</p>
						<p>
							I&rsquo;m also the founder and executive director of{' '}
							<a
								href={PDW.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-fg underline underline-offset-4 hover:no-underline"
							>
								{PDW.name}
								<span class="sr-only"> (opens in a new tab)</span>
							</a>
							, a BC nonprofit that builds free public tools on government data, public data, and
							open APIs. Its first two are{' '}
							<a href="/work/eaeo/" class="text-fg underline underline-offset-4 hover:no-underline">
								Employment and Education Outlooks
							</a>{' '}
							and the{' '}
							<a
								href="/work/puntledge/"
								class="text-fg underline underline-offset-4 hover:no-underline"
							>
								Puntledge Tube Report
							</a>
							.
						</p>
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-3">
						<a
							href="/contact/"
							class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
						>
							Start a conversation
						</a>
						<a
							href="/work/"
							class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm text-fg transition-colors hover:border-fg-subtle"
						>
							See the work
						</a>
					</div>
				</div>

				<figure class="lg:col-span-4">
					<Image
						src={ryan}
						alt="Ryan Roga, founder of Roga Digital"
						width={306}
						height={306}
						loading="eager"
						class="h-auto w-full max-w-[17rem] rounded-lg border border-border"
					/>
					<figcaption class="mt-4 text-sm">
						<span class="block font-medium text-fg">{SITE_AUTHOR}</span>
						<span class="block text-fg-muted">Founder &amp; lead developer, Roga Digital</span>
						<span class="block text-fg-muted">Founder &amp; Executive Director, {PDW.name}</span>
						<span class="mt-3 flex gap-4 font-mono text-2xs tracking-[0.16em] text-fg-subtle uppercase">
							<a
								href={SOCIAL.github}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center hover:text-fg"
							>
								GitHub
							</a>
							<a
								href={SOCIAL.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center hover:text-fg"
							>
								LinkedIn
							</a>
							<a href="/resume/" class="inline-flex min-h-11 items-center hover:text-fg">
								Resume
							</a>
						</span>
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- Principles -->
	<Section
		eyebrow="How I work"
		heading="Four defaults on every project."
		dek="These hold whether the job is a two-week dashboard or a year-long platform build."
	>
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<ol class="grid gap-px overflow-hidden rounded-lg border border-border bg-border lg:grid-cols-2">
				{principles.map((p) => (
					<li class="flex flex-col gap-3 bg-bg p-8">
						<span class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">{p.n}</span>
						<h3 class="text-xl font-medium tracking-tight text-balance text-fg">{p.h}</h3>
						<p class="text-sm text-fg-muted text-pretty">{p.b}</p>
					</li>
				))}
			</ol>
		</div>
	</Section>

	<!-- Stack -->
	<Section
		eyebrow="Stack"
		heading="What I build with."
		dek="The stack changes when something clearly better shows up, and not before."
		dense
	>
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<ul class="flex flex-wrap gap-2 font-mono text-2xs" role="list">
				{stack.map((s) => (
					<li class="rounded-sm border border-border bg-bg-soft px-3 py-1.5 tracking-[0.12em] text-fg-muted uppercase">
						{s}
					</li>
				))}
			</ul>
		</div>
	</Section>

	<!-- CTA -->
	<section class="border-t border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-8 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Next step</p>
					<h2 class="mt-3 text-2xl font-medium tracking-tight text-balance sm:text-3xl lg:text-4xl">
						Have something you&rsquo;d like built?
					</h2>
					<p class="mt-4 max-w-2xl text-lg text-fg-muted text-pretty">
						Tell me what you&rsquo;re working on. You get a candid read on whether I&rsquo;m the
						right fit, in writing, within 48 hours.
					</p>
				</div>
				<div class="flex lg:col-span-4 lg:justify-end">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
