---
import Section from '../../components/Section.astro';
import { ENGAGEMENT_FORMATS, SERVICES } from '../../data/services';
import Base from '../../layouts/Base.astro';

const title = 'Services: internal tools, custom software, AI & integrations · Roga Digital';
const description =
	'What Roga Digital builds: internal tools and dashboards, custom software, AI features, integrations, and the long-term maintenance of the software businesses depend on.';

const eyebrow = 'font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase';
---

<Base {title} {description}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="grid gap-10 pt-16 pb-14 sm:pt-20 sm:pb-16 lg:grid-cols-12 lg:items-end lg:gap-16">
				<div class="lg:col-span-8">
					<p class={eyebrow}>Services</p>
					<h1 class="mt-6 text-4xl font-medium tracking-tight text-balance sm:text-5xl lg:text-6xl">
						What I build, <span class="text-fg-muted">in detail.</span>
					</h1>
					<p class="mt-6 max-w-2xl text-lg text-fg-muted text-pretty sm:text-xl">
						Most projects draw on two or three of these at once: discovery shapes the architecture,
						the architecture shapes the code, and the code needs looking after once it ships. The
						first four have their own pages.
					</p>
				</div>
				<div class="lg:col-span-4 lg:text-right">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Tell me about your project
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- TOC -->
	<section class="border-b border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-6 sm:px-8">
			<nav aria-label="Services on this page">
				<p class={eyebrow}>On this page</p>
				<ul
					class="mt-2 grid gap-x-6 font-mono text-2xs tracking-[0.12em] uppercase sm:grid-cols-2 lg:grid-cols-3"
					role="list"
				>
					{SERVICES.map((s) => (
						<li>
							<a
								href={`#${s.id}`}
								class="inline-flex min-h-11 items-center gap-2 text-fg-muted transition-colors hover:text-fg"
							>
								<span class="text-fg-subtle">{s.number}</span>
								<span>{s.title}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</section>

	<!-- Service sections -->
	{SERVICES.map((s, i) => (
		<section id={s.id} class:list={['scroll-mt-20', i !== 0 && 'border-t border-border']}>
			<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
				<div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-5">
						<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">{s.number}</p>
						<h2 class="mt-4 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
							{s.title}
						</h2>
						<p class="mt-5 text-lg text-fg-muted text-pretty">{s.lead}</p>
						<ul class="mt-6 flex flex-wrap gap-1.5 font-mono text-2xs" role="list">
							{s.stack.map((t) => (
								<li class="rounded-sm border border-border px-2 py-0.5 text-fg-muted">{t}</li>
							))}
						</ul>
						<div class="mt-4 flex flex-col items-start">
							{s.page && (
								<a
									href={`/services/${s.page.slug}/`}
									class="inline-flex min-h-11 items-center gap-2 font-mono text-2xs tracking-[0.18em] text-fg uppercase underline-offset-4 hover:underline"
								>
									More on {s.title.toLowerCase()} →
								</a>
							)}
							{s.example && (
								<a
									href={s.example.href}
									class="inline-flex min-h-11 items-center gap-2 font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase transition-colors hover:text-fg"
								>
									See in production · {s.example.label} →
								</a>
							)}
						</div>
					</div>

					<div class="grid gap-10 lg:col-span-7 lg:grid-cols-2 lg:gap-8">
						<div>
							<h3 class={eyebrow}>What you get</h3>
							<ul class="mt-4 space-y-3 text-sm text-fg-muted" role="list">
								{s.deliverables.map((d) => (
									<li class="flex gap-2.5">
										<span
											class="mt-2 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-[var(--color-accent)]"
											aria-hidden="true"
										/>
										<span class="text-pretty">{d}</span>
									</li>
								))}
							</ul>
						</div>
						<div>
							<h3 class={eyebrow}>When it fits</h3>
							<ul class="mt-4 space-y-3 text-sm text-fg-muted" role="list">
								{s.whenYouReachFor.map((c) => (
									<li class="flex gap-2.5">
										<span
											class="mt-2 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-border-strong"
											aria-hidden="true"
										/>
										<span class="text-pretty">{c}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>
	))}

	<!-- Engagement formats -->
	<Section
		eyebrow="Engagement formats"
		heading="Three ways I usually work."
		dek="Most projects fit one of these shapes. Many start as one and become another over time."
	>
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<ul
				class="grid gap-px overflow-hidden rounded-lg border border-border bg-border lg:grid-cols-3"
				role="list"
			>
				{ENGAGEMENT_FORMATS.map((f) => (
					<li class="flex flex-col gap-3 bg-bg p-8">
						<h3 class="text-lg font-medium tracking-tight text-fg">{f.name}</h3>
						<p class="text-sm text-fg-muted text-pretty">{f.body}</p>
					</li>
				))}
			</ul>
		</div>
	</Section>

	<!-- End CTA -->
	<section class="border-t border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class={eyebrow}>Not sure which of these fits?</p>
					<h2 class="mt-3 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
						Start with the problem.
					</h2>
					<p class="mt-4 max-w-2xl text-fg-muted text-pretty">
						Send the problem, not the spec. We'll work out together which of these, if any, fits
						what you're trying to do.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
