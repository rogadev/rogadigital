---
import { getCollection } from 'astro:content';
import WorkCard from '../../components/WorkCard.astro';
import { SITE_LOCATION } from '../../consts';
import { SERVICE_PAGES, SERVICES, serviceHref } from '../../data/services';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
	return SERVICE_PAGES.map((service) => ({
		params: { slug: service.page.slug },
		props: { service },
	}));
}

interface Props {
	service: (typeof SERVICE_PAGES)[number];
}

const { service } = Astro.props;
const { page } = service;
const path = `/services/${page.slug}/`;

// Related case studies, in the order the service lists them.
const allWork = await getCollection('work');
const related = page.work.flatMap((id) => {
	const entry = allWork.find((w) => w.id === id && w.data.status !== 'draft');
	return entry ? [entry] : [];
});

const others = SERVICES.filter((s) => s.id !== service.id);

const jsonLd = [
	breadcrumbSchema(Astro.site, [
		{ name: 'Services', path: '/services/' },
		{ name: service.title, path },
	]),
	serviceSchema({
		site: Astro.site,
		path,
		name: service.title,
		description: page.seoDescription,
	}),
];

const eyebrow = 'font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase';
---

<Base title={page.seoTitle} description={page.seoDescription} {jsonLd}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-12 pb-14 sm:pt-16 sm:pb-16">
				<a
					href="/services/"
					class="inline-flex min-h-11 items-center gap-2 font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase transition-colors hover:text-fg"
				>
					<span aria-hidden="true">←</span> All services
				</a>

				<div class="mt-6 grid gap-10 lg:grid-cols-12 lg:gap-16">
					<div class="lg:col-span-7">
						<p class={eyebrow}>{service.title}</p>
						<h1 class="mt-4 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-5xl">
							{page.h1}
						</h1>
						<p class="mt-6 text-lg text-fg text-pretty sm:text-xl">{service.lead}</p>
						<div class="mt-8 flex flex-wrap items-center gap-3">
							<a
								href="/contact/"
								class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
							>
								Tell me about your project
							</a>
							<a
								href="#in-production"
								class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm text-fg transition-colors hover:border-fg-subtle"
							>
								See it in production
							</a>
						</div>
					</div>
					<div class="space-y-4 text-fg-muted lg:col-span-5 lg:pt-10">
						{page.intro.map((paragraph) => (
							<p class="text-pretty">{paragraph}</p>
						))}
						<ul class="flex flex-wrap gap-1.5 pt-2 font-mono text-2xs" role="list">
							{service.stack.map((t) => (
								<li class="rounded-sm border border-border px-2 py-0.5 text-fg-muted">{t}</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- What you get / when it fits -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
				<div>
					<h2 class="text-2xl font-medium tracking-tight sm:text-3xl">What you get</h2>
					<ul class="mt-6 divide-y divide-border border-y border-border" role="list">
						{service.deliverables.map((d) => (
							<li class="py-4 text-fg-muted text-pretty">{d}</li>
						))}
					</ul>
				</div>
				<div>
					<h2 class="text-2xl font-medium tracking-tight sm:text-3xl">When it fits</h2>
					<ul class="mt-6 divide-y divide-border border-y border-border" role="list">
						{service.whenYouReachFor.map((c) => (
							<li class="py-4 text-fg-muted text-pretty">{c}</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Related work -->
	{related.length > 0 && (
		<section id="in-production" class="scroll-mt-20 border-b border-border">
			<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
				<p class={eyebrow}>In production</p>
				<h2 class="mt-4 text-2xl font-medium tracking-tight text-balance sm:text-3xl lg:text-4xl">
					Where I&rsquo;ve done this before.
				</h2>
				<ul
					class:list={[
						'mt-10 grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2',
						related.length > 2 && 'lg:grid-cols-3',
					]}
					role="list"
				>
					{related.map((entry) => (
						<li>
							<WorkCard {entry} />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Other services -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 py-12 sm:px-8 sm:py-16">
			<nav aria-label="Other services">
				<p class={eyebrow}>Other services</p>
				<ul class="mt-2 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4" role="list">
					{others.map((s) => (
						<li>
							<a
								href={serviceHref(s)}
								class="inline-flex min-h-11 items-center text-sm text-fg-muted transition-colors hover:text-fg"
							>
								{s.title}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</section>

	<!-- End CTA -->
	<section class="bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class={eyebrow}>Based on {SITE_LOCATION} · working across Canada</p>
					<h2 class="mt-3 text-2xl font-medium tracking-tight text-balance sm:text-3xl lg:text-4xl">
						Send the problem, not the spec.
					</h2>
					<p class="mt-4 max-w-2xl text-fg-muted text-pretty">
						Tell me what your team is working around today. I read every message myself and reply in
						writing within 48 hours.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
