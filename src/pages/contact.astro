---
import InquiryForm from '../components/InquiryForm.svelte';
import Section from '../components/Section.astro';
import { SITE_LOCATION, SOCIAL } from '../consts';
import Base from '../layouts/Base.astro';

const title = 'Contact · Roga Digital';
const description =
	'Tell Roga Digital about your project. Send a message and get a real reply — a written read on scope and a rough budget — within 48 hours.';

const expect = [
	{
		n: '01',
		h: 'Send a message.',
		b: "Bullet points, a Loom, or a paragraph — whatever's easiest. The clearer the picture of what's broken or missing, the more useful my reply.",
	},
	{
		n: '02',
		h: 'I read it myself.',
		b: 'No autoresponder, no sales sequence. Every message reaches me directly.',
	},
	{
		n: '03',
		h: 'A written reply in 48 hours.',
		b: "If I can help, you get a written read on scope, what I'd build first, what I'd defer, and a rough budget. If I'm not the right fit, I'll say so and try to point you somewhere useful.",
	},
];

const helpful = [
	'A short description of the problem — no jargon required.',
	'How your team works around it today — the manual workaround.',
	'What success looks like — saved hours, revenue, or fewer mistakes.',
	'Constraints worth knowing: deadlines, existing systems, team size, budget range.',
];
---

<Base title={title} description={description}>
	<!-- Hero + message form -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-20 pb-16 sm:pt-28 sm:pb-20">
				<!-- Full-width header -->
				<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Contact</p>
				<h1 class="mt-6 text-4xl font-medium tracking-tight text-balance sm:text-5xl lg:text-6xl">
					Let&rsquo;s talk about <span class="text-fg-muted">your project.</span>
				</h1>

				<!-- Two columns: intro + what to expect (left), message form (right) -->
				<div class="mt-12 grid items-start gap-x-16 gap-y-14 sm:mt-14 lg:grid-cols-12">
					<!-- Left column: intro + what to expect -->
					<div class="lg:col-span-6">
						<p class="max-w-xl text-lg text-fg-muted text-pretty sm:text-xl">
							Tell me what you&rsquo;re working on &mdash; what&rsquo;s broken, what you&rsquo;ve
							tried, and what success looks like. If I can help, you&rsquo;ll have a written read on
							scope and a rough budget within 48 hours. If I can&rsquo;t, I&rsquo;ll say so.
						</p>

						<div class="mt-10 border-t border-border pt-8">
							<h2 class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
								What to expect
							</h2>
							<ol class="mt-6 divide-y divide-border border-y border-border" role="list">
								{expect.map((p) => (
									<li class="flex items-start gap-5 py-5">
										<span class="mt-0.5 font-mono text-2xs tracking-[0.18em] text-[var(--color-accent)] uppercase">
											{p.n}
										</span>
										<div>
											<h3 class="text-base font-medium tracking-tight text-fg">{p.h}</h3>
											<p class="mt-1 text-sm text-fg-muted text-pretty">{p.b}</p>
										</div>
									</li>
								))}
							</ol>
						</div>
					</div>

					<!-- Right column: the message form -->
					<div class="lg:col-span-6 lg:col-start-7">
						<h2 class="text-2xl font-medium tracking-tight text-balance text-fg sm:text-3xl">
							Send a message.
						</h2>
						<p class="mt-3 mb-8 text-fg-muted text-pretty">
							Straight to my inbox &mdash; no forms routed to a sales team, no pitch in return. A
							real reply within 48 hours.
						</p>
						<InquiryForm endpoint="/api/contact" client:load />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- What's helpful to include -->
	<Section
		eyebrow="Before you write"
		heading="What's helpful to include."
		dek="None of it is required — but if you have it handy, my first reply goes a lot further."
	>
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<ul class="divide-y divide-border border-y border-border" role="list">
				{helpful.map((item, i) => (
					<li class="flex items-start gap-6 py-5">
						<span class="pt-0.5 font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
							{String(i + 1).padStart(2, '0')}
						</span>
						<span class="text-fg text-pretty">{item}</span>
					</li>
				))}
			</ul>
		</div>
	</Section>

	<!-- Elsewhere / end note -->
	<section class="border-t border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-10 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<ul class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm" role="list">
						<li>
							<a
								href={SOCIAL.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								class="group inline-flex items-center gap-2"
							>
								<span class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
									LinkedIn
								</span>
								<span class="text-fg underline-offset-4 group-hover:underline">in/ryanroga</span>
							</a>
						</li>
						<li>
							<a
								href={SOCIAL.github}
								target="_blank"
								rel="noopener noreferrer"
								class="group inline-flex items-center gap-2"
							>
								<span class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
									GitHub
								</span>
								<span class="text-fg underline-offset-4 group-hover:underline">@rogadev</span>
							</a>
						</li>
						<li class="inline-flex items-center gap-2">
							<span class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
								Based
							</span>
							<span class="text-fg">{SITE_LOCATION}</span>
						</li>
					</ul>
					<p class="mt-6 max-w-2xl text-fg-muted text-pretty">
						Not ready to reach out yet? That's fine. The
						<a href="/work/" class="text-fg underline-offset-4 hover:underline">
							selected work
						</a>
						and{' '}
						<a href="/insights/" class="text-fg underline-offset-4 hover:underline">
							writing
						</a>
						give the clearest picture of how Roga Digital approaches a project.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/work/"
						class="inline-flex items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-fg-subtle"
					>
						View the work
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
