---
import Base from '../../layouts/Base.astro';
import { TOOLS } from '../../data/tools';

const title = 'Tools · Roga Digital';
const description =
	'Developer tools Ryan Roga built for his own work and shared because they are useful to others too, starting with orc-pack, an autonomous orchestrator for Claude Code.';
---

<Base {title} {description}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-20 pb-16 sm:pt-28 sm:pb-20">
				<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Tools</p>
				<h1 class="mt-6 max-w-3xl text-4xl font-medium tracking-tight text-balance sm:text-5xl">
					Built for my own work, shared for yours
				</h1>
				<p class="mt-6 max-w-2xl text-lg text-fg-muted text-pretty">
					The tooling I use every day to ship client work faster and more carefully. Each one
					started as something I needed, and each one is open source because it turned out other
					people needed it too.
				</p>
			</div>
		</div>
	</section>

	<!-- Tool list -->
	<section class="mx-auto w-full max-w-page px-6 py-12 sm:px-8 sm:py-16">
		<ul class="grid gap-4 sm:grid-cols-2">
			{TOOLS.map((tool) => (
				<li>
					<a
						href={tool.href}
						class="group flex h-full min-h-48 flex-col rounded-lg border border-border bg-bg-soft p-6 transition-colors hover:border-border-strong hover:bg-bg-elevated"
					>
						<div class="flex items-center justify-between gap-4">
							<span class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
								{tool.tag}
							</span>
							<span class="text-fg-subtle transition-colors group-hover:text-fg" aria-hidden="true">
								→
							</span>
						</div>
						<h2 class="mt-4 font-mono text-xl font-medium tracking-tight text-fg">{tool.name}</h2>
						<p class="mt-2 text-sm text-fg-muted text-pretty">{tool.description}</p>
						<span class="mt-auto truncate pt-4 font-mono text-2xs text-fg-subtle group-hover:text-fg-muted">
							{tool.repo.replace(/^https:\/\//, '')}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</Base>
