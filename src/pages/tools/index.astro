---
import { Image } from 'astro:assets';
import type { Tool } from '../../data/tools';
import { TOOLS } from '../../data/tools';
import Base from '../../layouts/Base.astro';

const title = 'Tools: Claude Code mods and free web tools · Roga Digital';
const description =
	'Claude Code mods and plugins, desktop productivity apps, and free browser tools, built by Ryan Roga for his own work and shared where they are useful to others.';

const groups = [
	{
		id: 'claude-code',
		heading: 'For Claude Code',
		dek: 'Mods, plugins, and skill packs I run every day while building client software with Claude Code.',
		tools: TOOLS.filter((t) => t.kind === 'mod'),
	},
	{
		id: 'apps',
		heading: 'Productivity apps',
		dek: 'Desktop apps I use all day. Both are still private while I finish them.',
		tools: TOOLS.filter((t) => t.kind === 'app'),
	},
	{
		id: 'websites',
		heading: 'Websites',
		dek: 'Small sites that do one job. All of them are free to use.',
		tools: TOOLS.filter((t) => t.kind === 'site'),
	},
];

/** Where the card goes: its own page first, then the live site, then the public repository. */
function destination(t: Tool): { href: string; external: boolean } | undefined {
	if (t.href) return { href: t.href, external: false };
	const url = t.liveUrl ?? t.repo;
	return url ? { href: url, external: true } : undefined;
}

/** The mono line at the foot of the card. */
function footnote(t: Tool): string {
	if (t.unreleased) return 'Not released yet';
	return (t.liveUrl ?? t.repo ?? '').replace(/^https:\/\//, '');
}
---

<Base {title} {description}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-16 pb-12 sm:pt-20 sm:pb-14">
				<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Tools</p>
				<h1 class="mt-6 max-w-3xl text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-5xl">
					Built for my own work, shared for yours.
				</h1>
				<p class="mt-6 max-w-2xl text-lg text-fg-muted text-pretty">
					Each of these started as something I needed. Most are open source or free to use. A few
					are still private while I finish them.
				</p>
				<ul
					class="mt-6 flex flex-wrap gap-x-6 font-mono text-2xs tracking-[0.16em] uppercase"
					role="list"
				>
					{groups.map((g) => (
						<li>
							<a
								href={`#${g.id}`}
								class="inline-flex min-h-11 items-center gap-2 text-fg-muted transition-colors hover:text-fg"
							>
								{g.heading}
								<span class="text-fg-subtle tabular-nums">{g.tools.length}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	{groups.map((g) => (
		<section id={g.id} class="scroll-mt-20 border-b border-border">
			<div class="mx-auto w-full max-w-page px-6 py-14 sm:px-8 sm:py-20">
				<h2 class="text-2xl font-medium tracking-tight sm:text-3xl">{g.heading}</h2>
				<p class="mt-3 max-w-2xl text-fg-muted text-pretty">{g.dek}</p>

				<ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" role="list">
					{g.tools.map((t) => {
						const dest = destination(t);
						const Wrapper = dest ? 'a' : 'div';
						return (
							<li>
								<Wrapper
									href={dest?.href}
									target={dest?.external ? '_blank' : undefined}
									rel={dest?.external ? 'noopener noreferrer' : undefined}
									class="group flex h-full flex-col"
								>
									{t.image && (
										<div class="mb-5 overflow-hidden rounded-lg border border-border bg-bg-soft transition-colors group-hover:border-border-strong">
											<Image
												src={t.image}
												alt=""
												widths={[400, 800]}
												sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
												class="block aspect-[16/10] h-auto w-full object-cover object-left-top"
											/>
										</div>
									)}
									<p class="font-mono text-2xs tracking-[0.16em] text-fg-subtle uppercase">
										{t.tag}
									</p>
									<h3
										class:list={[
											'mt-2 text-xl font-medium tracking-tight text-fg underline-offset-4',
											dest && 'group-hover:underline',
										]}
									>
										{t.name}
										{dest?.external && <span class="sr-only"> (opens in a new tab)</span>}
									</h3>
									<p class="mt-2 text-sm text-fg-muted text-pretty">{t.description}</p>
									<p class="mt-auto truncate pt-4 font-mono text-2xs text-fg-subtle">
										{footnote(t)}
										{dest?.external && <span aria-hidden="true"> ↗</span>}
									</p>
								</Wrapper>
							</li>
						);
					})}
				</ul>
			</div>
		</section>
	))}

	<!-- End CTA -->
	<section class="bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
						Need a tool that doesn&rsquo;t exist yet?
					</p>
					<h2 class="mt-3 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
						I build these for businesses too.
					</h2>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/work/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm text-fg transition-colors hover:border-fg-subtle"
					>
						See the client work
					</a>
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
