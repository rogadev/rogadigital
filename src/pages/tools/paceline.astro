---
import PacelineDemo from '../../components/tools/PacelineDemo.astro';
import Base from '../../layouts/Base.astro';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.name === 'paceline')!;

const title = 'paceline · Tools · Roga Digital';
const description =
	'paceline is a Claude Code status line that paces your usage limits into a daily budget and shows, at a glance, where every session stands.';

const segments = [
	{
		name: 'Model',
		example: 'Opus 5.5',
		body: 'The model, without the context-size suffix.',
	},
	{
		name: 'Effort',
		example: 'high effort',
		body: 'Only when effort is above low or medium.',
	},
	{
		name: 'Fast mode',
		example: 'fast mode',
		body: 'Only while fast mode is on.',
	},
	{
		name: 'Project',
		example: 'techcentral (dev)',
		body: 'The folder in a color unique to that project, and its git branch. Easy to tell three sessions apart.',
	},
	{
		name: 'Session',
		example: 's 18% (resets 3:40pm)',
		body: 'Five-hour limit left. The reset time appears once less than 30% is left. Verbose: "session 18% left".',
	},
	{
		name: 'Week',
		example: 'w 96%',
		body: 'Weekly limit left. Verbose: "week 96% left".',
	},
	{
		name: 'Today',
		example: 't 54% of 28%',
		body: 'How much of the budget for today is left, then the budget: the share of the week set aside for today, fixed all day. Go over and it turns red and shows how far over you are instead: "t over 18% of 28%". Verbose: "today 54% left of 28% budget".',
	},
	{
		name: 'Context',
		example: 'ctx 72%',
		body: 'Only when the context window is 70% or more full.',
	},
	{
		name: 'Cache',
		example: 'cache cold: 82k @ ~2x',
		body: 'Only when the prompt cache has expired.',
	},
	{
		name: 'Progress',
		example: 'loop ▰▰▰▰▱ #44 3/5',
		body: 'Only while an agent reports progress on a long job: one cell per step, with the current step and count.',
	},
	{
		name: 'Duration',
		example: '16m',
		body: 'How long the session has run. Always last, at the right edge.',
	},
];

const safety = [
	'No dependencies. It uses only the Go standard library.',
	'It never starts processes or touches the network, and the build fails if that changes. The optional paceline-mcp helper follows the same rules and only writes a progress file.',
	'It strips control characters from folder and branch names, so a hostile repo name cannot hijack your terminal.',
	'The installer backs up your settings and never overwrites a file it cannot parse.',
];
---

<Base {title} {description} ogPath="/og/tools.png">
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-20 pb-16 sm:pt-28 sm:pb-20">
				<a
					href="/tools/"
					class="inline-flex min-h-11 items-center gap-1.5 font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase transition-colors hover:text-fg"
				>
					<span aria-hidden="true">←</span> Tools
				</a>
				<h1 class="mt-4 max-w-3xl font-mono text-4xl font-medium tracking-tight sm:text-5xl">
					{tool.name}
				</h1>
				<p class="mt-6 max-w-2xl text-lg text-fg-muted text-pretty">
					Claude Code tells you how much of your weekly limit is left, but not whether that is a lot
					or a little for the days remaining. paceline divides what is left by the days until the
					reset, gives you today&rsquo;s budget, and counts it down as you work.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a
						href={tool.repo}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-4 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						View on GitHub <span aria-hidden="true">↗</span>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
					<a
						href="#install"
						class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm font-medium text-fg transition-colors hover:border-border-strong hover:bg-bg-elevated"
					>
						Install it
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Demo -->
	<section class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20" aria-labelledby="demo">
		<h2 id="demo" class="max-w-3xl text-2xl font-medium tracking-tight text-balance sm:text-3xl">
			One line, every session
		</h2>
		<p class="mt-4 mb-10 max-w-2xl text-fg-muted text-pretty">
			The status line sits under the prompt and updates as you work. Here is how it reads from a
			fresh day to a limit running out.
		</p>
		<PacelineDemo />
	</section>

	<!-- Segments -->
	<section class="border-t border-border" aria-labelledby="segments">
		<div class="mx-auto grid w-full max-w-page gap-10 px-6 py-16 sm:px-8 sm:py-20 lg:grid-cols-[2fr_3fr]">
			<div>
				<h2 id="segments" class="text-2xl font-medium tracking-tight sm:text-3xl">
					What each part means
				</h2>
				<p class="mt-4 text-fg-muted text-pretty">
					Every number is how much is left, counting down, so lower always means closer to a limit.
					The color of the today segment is the pace advice: green while you have room, yellow once
					less than 30% of the budget is left, and red below 15%. Whatever you don&rsquo;t spend
					spreads over the rest of the week, so a light Monday leaves bigger budgets later on.
					Prefer words? A verbose style spells the labels out.
				</p>
			</div>
			<dl class="divide-y divide-border border-y border-border">
				{segments.map((s) => (
					<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-6">
						<dt class="font-medium">{s.name}</dt>
						<dd class="min-w-0">
							<code class="font-mono text-xs break-words text-fg">{s.example}</code>
							<p class="mt-1 text-sm text-fg-muted text-pretty">{s.body}</p>
						</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<!-- Built to do very little -->
	<section class="border-t border-border" aria-labelledby="safety">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<h2 id="safety" class="text-2xl font-medium tracking-tight sm:text-3xl">
				Built to do very little
			</h2>
			<p class="mt-4 max-w-2xl text-fg-muted text-pretty">
				A status line runs on every refresh, in every repo you open. So paceline is a single binary
				that reads what Claude Code hands it and prints one line.
			</p>
			<ul class="mt-8 grid gap-4 sm:grid-cols-2">
				{safety.map((item) => (
					<li class="rounded-lg border border-border bg-bg-soft p-6 text-sm text-fg-muted text-pretty">
						{item}
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Install -->
	<section id="install" class="border-t border-border" aria-labelledby="install-heading">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<h2 id="install-heading" class="text-2xl font-medium tracking-tight sm:text-3xl">
				Install it
			</h2>
			<p class="mt-4 max-w-2xl text-fg-muted text-pretty">
				Download the binary for macOS, Linux, or Windows from the{' '}
				<a
					href={`${tool.repo}/releases/latest`}
					target="_blank"
					rel="noopener noreferrer"
					class="text-fg underline underline-offset-4 hover:no-underline"
				>
					latest release<span class="sr-only"> (opens in a new tab)</span>
				</a>
				, or build it with Go. Then point Claude Code at it:
			</p>
			<pre
				class="mt-6 max-w-2xl overflow-x-auto rounded-sm border border-border bg-bg-soft p-4 font-mono text-xs leading-relaxed"
				tabindex="0"
				role="region"
				aria-label="Install commands"
			><code>go install github.com/rogadev/paceline/cmd/paceline@latest
paceline install</code></pre>
			<p class="mt-4 max-w-2xl text-sm text-fg-muted text-pretty">
				<code class="font-mono text-fg">paceline uninstall</code> puts back whatever status line you
				had before.
			</p>
			<p class="mt-4 max-w-2xl text-sm text-fg-muted text-pretty">
				Run long jobs with{' '}
				<a href="/tools/orc-pack/" class="text-fg underline underline-offset-4 hover:no-underline">
					orc-pack
				</a>
				? Register the <code class="font-mono text-fg">paceline-mcp</code> server that ships in the
				same release, and every <code class="font-mono text-fg">/orc</code> run or{' '}
				<code class="font-mono text-fg">/orc-loop</code> batch shows up as a progress bar in your
				status line, with no extra setup.
			</p>
		</div>
	</section>

	<!-- End CTA -->
	<section class="border-t border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase">
						Want tooling like this for your team?
					</p>
					<h2 class="mt-3 text-2xl font-medium tracking-tight text-balance sm:text-3xl">
						Let&rsquo;s talk about it.
					</h2>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/contact/"
						class="inline-flex items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
