---
import ArrowIcon from '../../components/ArrowIcon.astro';
import ThemedImage from '../../components/ThemedImage.astro';
import Base from '../../layouts/Base.astro';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.name === 'Launchpad')!;

const title = 'Launchpad · Tools · Roga Digital';
const description =
	'Launchpad is a Windows tray app that opens Claude Code sessions for your projects from one grid of tiles, grouped into sections, with icons that Claude draws for you.';

const features = [
	{
		name: 'One click, one session',
		body: 'A tile opens PowerShell in its project folder and starts Claude Code. Hold Shift and click several tiles to open each one in its own window.',
	},
	{
		name: 'Tiles stay where you put them',
		body: 'Drag a tile to any cell, like desktop icons with auto-arrange off. Gaps stay where you leave them, and nothing reflows when you resize the window.',
	},
	{
		name: 'Sections',
		body: 'Draw a named outline around related tiles, such as Client work. Drop a tile on a section to add it, or drag the label to move the whole group.',
	},
	{
		name: 'Type to find',
		body: "Start typing and the tiles that don't match fade out without moving. Enter opens the first match.",
	},
	{
		name: 'Icons drawn by Claude',
		body: "Right-click a tile and choose Generate icon with Claude. Claude Code reads the project's README with read-only tools and draws a new icon in under half a minute.",
	},
	{
		name: 'Your old launchers come along',
		body: 'Import every shortcut on your desktop. One-line Claude Code launchers become tiles with their icons, and anything more involved is kept as a saved command.',
	},
];
---

<Base {title} {description} ogPath="/og/tools.png">
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-20 pb-16 sm:pt-28 sm:pb-20">
				<a
					href="/tools/"
					class="inline-flex min-h-11 items-center gap-1.5 font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase transition-colors hover:text-fg"
				>
					<ArrowIcon direction="left" /> Tools
				</a>
				<h1 class="mt-4 max-w-3xl font-mono text-4xl font-medium tracking-tight sm:text-5xl">
					{tool.name}
				</h1>
				<p class="mt-6 max-w-2xl text-lg text-fg-muted text-pretty">
					A Windows tray app for anyone who keeps a Claude Code session open for every project.
					Click the tray icon and a grid of your projects pops up; click a tile and Claude Code
					opens in that folder. It replaces a desktop full of shortcuts,{' '}
					<code class="font-mono text-base text-fg">.bat</code> launchers, and loose icon files.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
					<span class="rounded-sm border border-border bg-bg-soft px-3 py-1.5 font-mono text-2xs tracking-[0.16em] text-fg-subtle uppercase">
						Not released yet
					</span>
					<p class="text-sm text-fg-muted">
						It&rsquo;s private while I finish it. This page will link the download when it ships.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- The board -->
	<section class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20" aria-labelledby="board">
		<h2 id="board" class="max-w-3xl text-2xl font-medium tracking-tight text-balance sm:text-3xl">
			Your projects, grouped the way you think about them
		</h2>
		<p class="mt-4 mb-10 max-w-2xl text-fg-muted text-pretty">
			An example board for a developer with a day job, a few freelance clients, side projects, and
			some tools they built for themselves. The projects are made up, but the icons are real: Claude
			drew each one through Launchpad&rsquo;s own Generate icon button.
		</p>
		<figure>
			<ThemedImage
				src={tool.image!}
				darkSrc={tool.imageDark}
				alt="The Launchpad window: a search box above a grid of project tiles with colourful icons. Outlined, labelled sections group them as Day job, Freelance, Side projects, My tools, Games, and Graveyard, with a few loose tiles such as scratch, notes, and Expenses 2026."
				widths={[640, 1280, 1920]}
				sizes="(min-width: 1280px) 1216px, 100vw"
				class="block h-auto w-full max-w-full rounded-lg border border-border"
			/>
		</figure>
	</section>

	<!-- What it does -->
	<section class="border-t border-border" aria-labelledby="features">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<h2 id="features" class="text-2xl font-medium tracking-tight sm:text-3xl">
				What it does
			</h2>
			<p class="mt-4 max-w-2xl text-fg-muted text-pretty">
				Launchpad starts with Windows and waits in the system tray. It opens next to the tray, hides
				when you click anywhere else or press Esc, and reopens where and at the size you left it. It
				follows your Windows light or dark setting.
			</p>
			<ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
				{features.map((f) => (
					<li>
						<h3 class="font-medium">{f.name}</h3>
						<p class="mt-2 text-sm text-fg-muted text-pretty">{f.body}</p>
					</li>
				))}
			</ul>
			<p class="mt-12 max-w-2xl text-sm text-fg-muted text-pretty">
				Built with Tauri 2 and Rust, for Windows only. A command-line{' '}
				<code class="font-mono text-fg">add</code> lets Claude Code put a project it just created
				straight onto the grid.
			</p>
		</div>
	</section>

	<!-- End CTA -->
	<section class="border-t border-border bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase">
						Want tooling like this for your team?
					</p>
					<h2 class="mt-3 text-2xl font-medium tracking-tight text-balance sm:text-3xl">
						Let&rsquo;s talk about it.
					</h2>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
