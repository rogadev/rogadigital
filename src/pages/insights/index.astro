---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const title = 'Insights · Roga Digital';
const description =
	'Writing from Roga Digital: opinions on tooling and technology, takes on where AI is headed, industry shifts, and notes from building software for businesses.';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [latest, ...rest] = posts;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

const meta = 'font-mono text-2xs tracking-[0.16em] text-fg-subtle uppercase';
---

<Base {title} {description}>
	<!-- Hero -->
	<section class="border-b border-border">
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<div class="pt-16 pb-12 sm:pt-20 sm:pb-14">
				<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Insights</p>
				<h1 class="mt-6 text-3xl font-medium tracking-tight text-balance sm:text-4xl lg:text-5xl">
					Notes from the work.
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-fg-muted text-pretty">
					Opinions on tooling and technology, where AI is headed, and what I learn building and
					running software for clients.
				</p>
				<a
					href="/rss.xml"
					class="mt-2 inline-flex min-h-11 items-center font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase underline-offset-4 hover:text-fg hover:underline"
				>
					Subscribe by RSS →
				</a>
			</div>
		</div>
	</section>

	{latest ? (
		<>
			{/* Latest post */}
			<section class="border-b border-border">
				<div class="mx-auto w-full max-w-page px-6 py-12 sm:px-8 sm:py-16">
					<a
						href={`/insights/${latest.id}/`}
						class="group grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12"
					>
						{latest.data.heroImage && (
							<div class="overflow-hidden rounded-lg border border-border bg-bg-soft transition-colors group-hover:border-border-strong lg:col-span-7">
								<Image
									src={latest.data.heroImage}
									alt=""
									widths={[640, 960, 1400]}
									sizes="(min-width: 1024px) 690px, 100vw"
									loading="eager"
									class="block aspect-[16/9] h-auto w-full object-cover"
								/>
							</div>
						)}
						<div class:list={[latest.data.heroImage ? 'lg:col-span-5' : 'lg:col-span-9']}>
							<p class={meta}>
								Latest ·{' '}
								<time datetime={latest.data.pubDate.toISOString()}>
									{dateFormatter.format(latest.data.pubDate)}
								</time>
								{latest.data.readingTime && <> · {latest.data.readingTime}</>}
							</p>
							<h2 class="mt-4 text-2xl font-medium tracking-tight text-balance text-fg underline-offset-4 group-hover:underline sm:text-3xl">
								{latest.data.title}
							</h2>
							<p class="mt-4 text-fg-muted text-pretty">{latest.data.description}</p>
							<p class="mt-4 inline-flex min-h-11 items-center font-mono text-2xs tracking-[0.18em] text-fg-muted uppercase transition-colors group-hover:text-fg">
								Read the post →
							</p>
						</div>
					</a>
				</div>
			</section>

			{/* Earlier posts */}
			{rest.length > 0 && (
				<section class="border-b border-border">
					<div class="mx-auto w-full max-w-page px-6 py-12 sm:px-8 sm:py-16">
						<h2 class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Earlier</h2>
						<ul class="mt-6 divide-y divide-border border-y border-border" role="list">
							{rest.map((post) => (
								<li>
									<a
										href={`/insights/${post.id}/`}
										class="group grid gap-2 py-6 sm:grid-cols-12 sm:gap-8 sm:py-7"
									>
										<p class={`${meta} sm:col-span-3 sm:pt-1.5`}>
											<time datetime={post.data.pubDate.toISOString()}>
												{dateFormatter.format(post.data.pubDate)}
											</time>
											{post.data.readingTime && (
												<>
													<span class="sm:hidden"> · </span>
													<span class="sm:mt-1 sm:block">{post.data.readingTime}</span>
												</>
											)}
										</p>
										<div class="sm:col-span-9">
											<h3 class="text-xl font-medium tracking-tight text-balance text-fg underline-offset-4 group-hover:underline">
												{post.data.title}
											</h3>
											<p class="mt-2 max-w-3xl text-fg-muted text-pretty">
												{post.data.description}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)}
		</>
	) : (
		<section class="border-b border-border">
			<div class="mx-auto w-full max-w-page px-6 py-24 sm:px-8 sm:py-32">
				<p class="text-fg-muted">The first post lands soon.</p>
			</div>
		</section>
	)}

	<!-- End CTA -->
	<section class="bg-bg-soft">
		<div class="mx-auto w-full max-w-page px-6 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-6 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-8">
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">
						More from Roga Digital
					</p>
					<h2 class="mt-3 text-2xl font-medium tracking-tight text-balance sm:text-3xl">
						See the work, or get in touch.
					</h2>
				</div>
				<div class="flex flex-wrap items-center gap-3 lg:col-span-4 lg:justify-end">
					<a
						href="/work/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm text-fg transition-colors hover:border-fg-subtle"
					>
						Selected work
					</a>
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
