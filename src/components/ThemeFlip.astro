---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * ThemeFlip: a light and a dark capture of the same screen, stacked like two
 * cards. The capture for the site's current theme sits in front; the other
 * peeks out behind its top-right corner. A sun-and-moon badge on that corner
 * shuffles them, so a visitor can see the app supports both themes.
 *
 * Before the badge is pressed, the front card follows the site theme (the rule
 * keys on `html.light`, like ThemedImage). After a press, the choice is local
 * to this component and stays put until pressed again.
 */
interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
	widths: number[];
	sizes: string;
	/** Where the front card links. Without it, the cards are plain images. */
	href?: string;
	/** Accessible name for the link. */
	hrefLabel?: string;
	/** Load eagerly, for an image that is the page's LCP element. */
	priority?: boolean;
	class?: string;
}

const {
	light,
	dark,
	alt,
	widths,
	sizes,
	href,
	hrefLabel,
	priority = false,
	class: className = '',
} = Astro.props;

const loading = priority ? 'eager' : 'lazy';
const Wrapper = href ? 'a' : 'div';
---

<div class:list={['theme-flip relative', className]} data-theme-flip>
	<Wrapper href={href} aria-label={href ? hrefLabel : undefined} class="theme-flip__stack grid">
		<span class="theme-flip__card theme-flip__card--dark" data-card="dark">
			<Image src={dark} alt={alt} {widths} {sizes} loading={loading} class="block h-auto w-full" />
		</span>
		<span class="theme-flip__card theme-flip__card--light" data-card="light">
			<Image src={light} alt={alt} {widths} {sizes} loading={loading} class="block h-auto w-full" />
		</span>
	</Wrapper>

	<button type="button" class="theme-flip__toggle" data-theme-flip-toggle hidden>
		<svg
			class="theme-flip__icon theme-flip__icon--sun"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</svg>
		<svg
			class="theme-flip__icon theme-flip__icon--moon"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
		</svg>
		<span class="sr-only" data-theme-flip-label></span>
	</button>
</div>

<script>
	const flips = document.querySelectorAll<HTMLElement>('[data-theme-flip]');

	/** The theme of the card in front: the local choice, else the site theme. */
	const front = (flip: HTMLElement) =>
		(flip.dataset.front as 'light' | 'dark' | undefined) ??
		(document.documentElement.classList.contains('light') ? 'light' : 'dark');

	const sync = (flip: HTMLElement) => {
		const button = flip.querySelector<HTMLButtonElement>('[data-theme-flip-toggle]');
		const label = flip.querySelector('[data-theme-flip-label]');
		if (!button || !label) return;
		const other = front(flip) === 'dark' ? 'light' : 'dark';
		label.textContent = `Show the ${other} mode version`;
		button.dataset.shows = other;
		// The card behind is decoration until it comes forward.
		for (const card of flip.querySelectorAll<HTMLElement>('[data-card]')) {
			card.setAttribute('aria-hidden', String(card.dataset.card !== front(flip)));
		}
	};

	for (const flip of flips) {
		const button = flip.querySelector<HTMLButtonElement>('[data-theme-flip-toggle]');
		if (!button) continue;
		button.hidden = false;
		button.addEventListener('click', () => {
			flip.dataset.front = front(flip) === 'dark' ? 'light' : 'dark';
			sync(flip);
		});
		sync(flip);
	}

	// Until a visitor picks one, the front card follows the site theme toggle.
	new MutationObserver(() => flips.forEach(sync)).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['class'],
	});
</script>

<style>
	.theme-flip {
		/* How far the back card peeks out past the front one. */
		--peek: 0.75rem;
		padding-top: var(--peek);
		padding-right: var(--peek);
	}

	@media (min-width: 640px) {
		.theme-flip {
			--peek: 1rem;
		}
	}

	.theme-flip__stack {
		position: relative;
		isolation: isolate;
		border-radius: var(--radius-lg, 0.5rem);
	}

	.theme-flip__stack:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	.theme-flip__card {
		grid-area: 1 / 1;
		display: block;
		overflow: hidden;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-lg, 0.5rem);
		background: var(--color-bg-soft);
		transform-origin: top right;
		transition:
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
			filter 520ms ease,
			z-index 0ms linear 200ms;
	}

	/* Front and back, before any choice: the card for the site theme leads. */
	.theme-flip__card--dark {
		z-index: 2;
	}
	.theme-flip__card--light,
	:global(html.light) .theme-flip:not([data-front]) .theme-flip__card--dark,
	.theme-flip[data-front='light'] .theme-flip__card--dark {
		z-index: 1;
		transform: translate(var(--peek), calc(var(--peek) * -1)) scale(0.97);
		filter: brightness(0.75) saturate(0.9);
	}
	:global(html.light) .theme-flip:not([data-front]) .theme-flip__card--light,
	.theme-flip[data-front='light'] .theme-flip__card--light {
		z-index: 2;
		transform: none;
		filter: none;
	}
	.theme-flip[data-front='dark'] .theme-flip__card--dark {
		z-index: 2;
		transform: none;
		filter: none;
	}
	.theme-flip[data-front='dark'] .theme-flip__card--light {
		z-index: 1;
		transform: translate(var(--peek), calc(var(--peek) * -1)) scale(0.97);
		filter: brightness(0.75) saturate(0.9);
	}

	/* A hint on hover: the back card slides out a little further. */
	@media (hover: hover) {
		.theme-flip:has(.theme-flip__toggle:hover) .theme-flip__card[aria-hidden='true'] {
			transform: translate(calc(var(--peek) * 1.6), calc(var(--peek) * -1.6)) scale(0.97);
		}
	}

	.theme-flip__toggle {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 3;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		translate: 35% -35%;
		/* Inverted against the site theme so the badge stands out on either capture. */
		border: 1px solid var(--color-fg);
		border-radius: 9999px;
		background: var(--color-fg);
		color: var(--color-bg);
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
		cursor: pointer;
		transition:
			transform 200ms ease,
			border-color 200ms ease;
	}

	/* A 44px touch target around the 36px badge. */
	.theme-flip__toggle::after {
		content: '';
		position: absolute;
		inset: -0.25rem;
	}

	.theme-flip__toggle:hover {
		transform: rotate(-12deg) scale(1.06);
		border-color: var(--color-fg-muted);
	}

	.theme-flip__toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.theme-flip__icon {
		grid-area: 1 / 1;
		transition:
			opacity 300ms ease,
			transform 300ms ease;
	}

	/* The badge shows the theme it will switch to. */
	.theme-flip__toggle[data-shows='dark'] .theme-flip__icon--sun,
	.theme-flip__toggle[data-shows='light'] .theme-flip__icon--moon {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-flip__card,
		.theme-flip__toggle,
		.theme-flip__icon {
			transition: none;
		}
	}
</style>
