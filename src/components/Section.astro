---
/**
 * Section — bordered "frame" with consistent vertical rhythm.
 * Optional eyebrow label (mono, small, uppercase) and section heading.
 */
interface Props {
	id?: string;
	eyebrow?: string;
	heading?: string;
	dek?: string;
	class?: string;
	bordered?: boolean;
	dense?: boolean;
	/** Lets the heading and dek span the page width instead of a reading-width cap. */
	wide?: boolean;
}

const {
	id,
	eyebrow,
	heading,
	dek,
	class: className = '',
	bordered = true,
	dense = false,
	wide = false,
} = Astro.props;
---

<section
	id={id}
	class:list={[
		'relative',
		bordered && 'border-t border-border',
		dense ? 'py-12 sm:py-16' : 'py-20 sm:py-28',
		className,
	]}
>
	{(eyebrow || heading || dek) && (
		<div class="mx-auto w-full max-w-page px-6 sm:px-8">
			<header class:list={['mb-12 sm:mb-16', !wide && 'max-w-3xl']}>
				{eyebrow && (
					<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">{eyebrow}</p>
				)}
				{heading && (
					<h2
						class:list={[
							'text-2xl font-medium tracking-tight text-balance sm:text-3xl xl:text-4xl',
							eyebrow && 'mt-4',
						]}
					>
						{heading}
					</h2>
				)}
				{dek && (
					<p class:list={['mt-4 text-lg text-fg-muted text-pretty', !wide && 'max-w-2xl']}>{dek}</p>
				)}
			</header>
		</div>
	)}

	<slot />
</section>
