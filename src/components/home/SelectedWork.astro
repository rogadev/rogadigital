---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';

const work = (await getCollection('work'))
	.filter((entry) => entry.data.featured && entry.data.status !== 'draft')
	.toSorted((a, b) => a.data.order - b.data.order);
---

<Section id="work">
	<div class="mx-auto w-full max-w-page px-6 sm:px-8">
		<header class="mb-12 grid gap-6 sm:mb-16 lg:grid-cols-12 lg:items-end lg:gap-12">
			<div class="lg:col-span-5">
				<p class="font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase">Our work</p>
				<h2 class="mt-4 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
					See our work.
				</h2>
			</div>
			<p class="text-lg text-fg-muted text-balance lg:col-span-7 lg:text-xl">
				The proof is in production. Every project here is a real system a business relies on —
				designed, built, and shipped end-to-end, and maintained by us to this day.
			</p>
		</header>
	</div>
	<div class="mx-auto w-full max-w-page">
		<ul
			class="grid grid-cols-1 gap-px overflow-hidden border-y border-border bg-border lg:grid-cols-2"
			role="list"
		>
			{work.map((w, i) => {
				// A lone last card spans both columns from lg up; lay its content out in two columns too.
				const spans = work.length % 2 === 1 && i === work.length - 1;
				return (
					<li
						class:list={[
							'group bg-bg transition-colors hover:bg-bg-soft',
							spans && 'lg:col-span-2',
						]}
					>
						<a
							href={`/work/${w.id}/`}
							class:list={[
								'flex h-full flex-col gap-6 p-6 sm:p-8',
								spans && 'lg:grid lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-x-12',
							]}
							aria-label={`${w.data.client} — ${w.data.headline}`}
						>
							<div class="space-y-1.5 font-mono text-2xs tracking-[0.18em] uppercase">
								<p class="text-[var(--color-accent)]">{w.data.client}</p>
								<p class="text-fg-subtle">{w.data.industry}</p>
							</div>

							<div>
								<h3 class="text-2xl font-medium tracking-tight text-balance text-fg sm:text-3xl">
									{w.data.headline}
								</h3>
								<p class="mt-3 max-w-xl text-sm text-fg-muted">{w.data.outcome}</p>
							</div>

							<div
								class:list={[
									'mt-auto flex flex-col gap-5',
									spans && 'lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:justify-end',
								]}
							>
								<ul class="flex flex-wrap gap-1.5 font-mono text-2xs" role="list">
									{w.data.tags.map((t) => (
										<li class="rounded-sm border border-border px-2 py-0.5 text-fg-muted">{t}</li>
									))}
								</ul>
								<span class="inline-flex items-center gap-1.5 font-mono text-2xs tracking-[0.18em] text-fg-subtle uppercase transition-colors group-hover:text-fg">
									Read case study →
								</span>
							</div>
						</a>
					</li>
				);
			})}
		</ul>

		<div class="mt-12 px-6 sm:px-8">
			<a
				href="/work/"
				class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.16em] text-fg-muted uppercase transition-colors hover:text-fg"
			>
				All work
				<svg
					width="12"
					height="12"
					viewBox="0 0 16 16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M3 8h10M9 4l4 4-4 4"></path>
				</svg>
			</a>
		</div>
	</div>
</Section>
