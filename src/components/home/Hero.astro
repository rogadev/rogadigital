---
import ArrowIcon from '../ArrowIcon.astro';
import dispatchBoard from '../../assets/work/roga-dispatch/01-board.png';
import dispatchBoardDark from '../../assets/work/roga-dispatch/01-board-dark.png';
import ThemeFlip from '../ThemeFlip.astro';
---

<section class="border-b border-border">
	<div class="mx-auto w-full max-w-page px-6 sm:px-8">
		<div class="grid gap-12 pt-16 pb-16 sm:pt-20 sm:pb-20 lg:grid-cols-12 lg:items-center lg:gap-10">
			<div class="lg:col-span-5">
				<h1 class="text-3xl font-medium tracking-tight text-balance sm:text-4xl xl:text-5xl">
					I build the tools your business runs on.
				</h1>

				<p class="mt-6 max-w-xl text-lg text-fg-muted text-pretty">
					<span class="text-fg">Roga Digital</span> is Ryan Roga&rsquo;s software studio. I design,
					build, and maintain dashboards, operations software, integrations, and AI features for
					businesses that have outgrown spreadsheets and off-the-shelf tools.
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
					<a
						href="/contact/"
						class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
					>
						Tell me about your project
						<svg
							width="14"
							height="14"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M3 8h10M9 4l4 4-4 4"></path>
						</svg>
					</a>
					<a
						href="/work/"
						class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm text-fg transition-colors hover:border-fg-subtle"
					>
						View case studies
					</a>
				</div>
			</div>

			<figure class="lg:col-span-7">
				<ThemeFlip
					light={dispatchBoard}
					dark={dispatchBoardDark}
					alt="The Roga Dispatch board: today's trips grouped by what needs attention, with late pickups, drivers out of service, and unassigned trips at the top."
					widths={[640, 960, 1280]}
					sizes="(min-width: 1024px) 680px, 100vw"
					href="/work/roga-dispatch/"
					hrefLabel="Roga Dispatch case study"
					priority
				/>
				<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 font-mono text-2xs tracking-[0.14em] text-fg-subtle uppercase">
					<span>Driving service dispatch dashboard</span>
					<a
						href="/work/roga-dispatch/"
						class="ml-auto inline-flex gap-1.5 min-h-11 items-center text-fg-muted underline-offset-4 hover:text-fg hover:underline"
					>
						Try the live demo
						<ArrowIcon />
					</a>
				</figcaption>
			</figure>
		</div>
	</div>
</section>
