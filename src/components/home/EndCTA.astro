---
import ArrowIcon from '../ArrowIcon.astro';
---

<section class="border-t border-border bg-bg-soft">
	<div class="mx-auto w-full max-w-page px-6 py-24 sm:px-8 sm:py-32">
		<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
			<div class="lg:col-span-8">
				<h2 class="text-2xl font-medium tracking-tight text-balance sm:text-3xl xl:text-4xl">
					Have a tool your team needs?
				</h2>
				<p class="mt-5 max-w-2xl text-lg text-fg-muted text-pretty">
					Describe the problem, even if you don't know yet what the fix looks like. I read every
					message myself and reply in writing within 48 hours.
				</p>
			</div>
			<div class="flex flex-wrap items-center justify-end gap-3 lg:col-span-4">
				<a
					href="/contact/"
					class="inline-flex min-h-11 items-center gap-2 rounded-md bg-fg px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
				>
					Get in touch
					<ArrowIcon size={14} />
				</a>
			</div>
		</div>
	</div>
</section>
