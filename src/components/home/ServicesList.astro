---
import ArrowIcon from '../ArrowIcon.astro';
import { SERVICES, serviceHref } from '../../data/services';
import Section from '../Section.astro';
import ServiceIcon from '../ServiceIcon.astro';
---

<Section
	id="services"
	heading="What I build."
	dek="When spreadsheets and off-the-shelf software stop fitting the way you work, I build what does, and I keep it running."
>
	<div class="mx-auto w-full max-w-page px-6 sm:px-8">
		<ul class="border-t border-border md:grid md:grid-cols-2 md:gap-x-12" role="list">
			{SERVICES.map((s) => (
				<li class="border-b border-border">
					<a href={serviceHref(s)} class="group flex min-h-11 items-start gap-4 py-4">
						<ServiceIcon
							id={s.id}
							class="mt-0.5 shrink-0 text-fg-subtle transition-colors group-hover:text-fg"
						/>
						<span class="flex-1">
							<span class="block font-medium tracking-tight text-fg underline-offset-4 group-hover:underline">
								{s.title}
							</span>
							<span class="mt-0.5 block text-sm text-fg-muted">{s.summary}</span>
						</span>
						<span class="flex h-[1lh] items-center text-fg-subtle transition-colors group-hover:text-fg">
							<ArrowIcon size={14} />
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</Section>
