---
import { demoPage, demoSite, demoUrl, snapshotPath } from '../../lib/demos';
import DemoFrame from '../DemoFrame.astro';
import Section from '../Section.astro';

const site = demoSite('puntledge');
const home = demoPage(site, 'puntledge-home');
const report = demoPage(site, 'puntledge-report');
---

<Section
	id="live-demo"
	eyebrow="Featured project · Live"
	heading="Puntledge Tube Report"
	dek="Our latest launch answers one question: is the Puntledge River worth floating today? The site blends live river gauge data, weather, and tides with anonymous reports from tubers who just got off the water, then turns it all into a plain-language verdict. Built with SvelteKit and Neon Postgres, deployed on Cloudflare."
>
	<div class="mx-auto w-full max-w-page px-6 sm:px-8">
		<div class="relative md:pr-32 md:pb-14">
			<DemoFrame
				src={demoUrl(site, home)}
				snapshot={snapshotPath(home)}
				label={home.label}
				title="Puntledge Tube Report — today's conditions (desktop demo)"
				href="/work/puntledge/"
				hrefLabel="Read the Puntledge Tube Report case study"
			/>
			<div class="absolute right-0 -bottom-2 hidden w-[13.5rem] md:block">
				<DemoFrame
					kind="phone"
					src={demoUrl(site, report)}
					snapshot={snapshotPath(report)}
					title="Puntledge Tube Report — report your float (mobile demo)"
					href="/work/puntledge/"
					hrefLabel="Read the Puntledge Tube Report case study"
				/>
			</div>
		</div>
		<div class="mx-auto mt-8 w-full max-w-[16rem] md:hidden">
			<DemoFrame
				kind="phone"
				src={demoUrl(site, report)}
				snapshot={snapshotPath(report)}
				title="Puntledge Tube Report — report your float (mobile demo)"
				href="/work/puntledge/"
				hrefLabel="Read the Puntledge Tube Report case study"
			/>
		</div>
		<div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-3">
			<a
				href="/work/puntledge/"
				class="inline-flex min-h-11 items-center gap-2 font-mono text-xs tracking-[0.16em] text-fg uppercase underline-offset-4 hover:underline"
			>
				Read the case study →
			</a>
			<a
				href="https://puntledge.ca"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex min-h-11 items-center gap-2 font-mono text-xs tracking-[0.16em] text-fg-muted uppercase transition-colors hover:text-fg"
			>
				Visit puntledge.ca <span aria-hidden="true">↗</span>
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</div>
	</div>
</Section>
