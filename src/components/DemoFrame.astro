---
/**
 * DemoFrame — a live site embedded in a desktop or phone device frame.
 *
 * The iframe renders at the device's native viewport size (so the embedded
 * site lays out as real desktop or mobile) and is scaled to fit its container
 * with a container-query trig expression — no JS needed for sizing, and the
 * frame tracks the page layout responsively.
 *
 * With `href` set, the frame is a pure preview: a full-frame link covers the
 * embed (clicks navigate, page scrolling never gets trapped inside it), and the
 * live iframe is sandboxed without forms, popups, or top navigation.
 * Without `href`, the embed is directly interactive. When a `snapshot` path is
 * given, a client-side reachability probe swaps the iframe to the local
 * snapshot (captured by src/integrations/demo-snapshots.ts) if the live site
 * is down or answering with an error.
 *
 * With `themed` set, the frame follows the site's light or dark theme: the
 * live URL carries `?theme=`, the snapshot switches to `snapshotDark` in dark
 * mode, and both update when the visitor toggles the theme.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { themedUrl } from '../lib/demos';

interface Props {
	kind?: 'desktop' | 'phone';
	/** URL of the live (embeddable) demo route. */
	src: string;
	/** Local fallback snapshot path, e.g. from snapshotPath() in src/lib/demos.ts. */
	snapshot?: string;
	/** The live route accepts `?theme=light|dark`; see DemoPage.themed in src/lib/demos.ts. */
	themed?: boolean;
	/** Dark-theme fallback snapshot path, e.g. snapshotPath(page, 'dark'). */
	snapshotDark?: string;
	/** Accessible iframe title. */
	title: string;
	/** Address shown in the browser-chrome bar (desktop frames only). */
	label?: string;
	/** When set, the whole frame links here instead of being interactive. */
	href?: string;
	/** Accessible name for the `href` link. Required when `href` is set. */
	hrefLabel?: string;
	/** Open the `href` link in a new tab. */
	external?: boolean;
	class?: string;
}

const {
	kind = 'desktop',
	src,
	snapshot,
	themed = false,
	snapshotDark,
	title,
	label,
	href,
	hrefLabel,
	external = false,
	class: className = '',
} = Astro.props;

const native = kind === 'desktop' ? { w: 1280, h: 800 } : { w: 390, h: 780 };
const chromeLabel = label ?? new URL(src).hostname;
// The site renders dark until its head script finds a light preference, so the
// markup asks for dark and the script below corrects it before the lazy load.
const initialSrc = themed ? themedUrl(src, 'dark') : src;
// A dark snapshot exists only once the live site has served ?theme=dark to a
// capture; until then, dark mode falls back to the light snapshot.
const darkSnapshot =
	themed && snapshotDark && existsSync(join(process.cwd(), 'public', snapshotDark))
		? snapshotDark
		: undefined;
---

<figure class:list={['demo-frame not-prose relative', className]} data-demo-frame>
	<div
		class:list={[
			'overflow-hidden bg-bg-soft',
			kind === 'desktop'
				? 'rounded-lg border border-border'
				: 'rounded-[1.625rem] border border-border-strong p-1.5',
		]}
	>
		{kind === 'desktop' && (
			<div class="relative flex items-center gap-1.5 border-b border-border px-3 py-2">
				<span class="h-2 w-2 rounded-full bg-border-strong" aria-hidden="true" />
				<span class="h-2 w-2 rounded-full bg-border-strong" aria-hidden="true" />
				<span class="h-2 w-2 rounded-full bg-border-strong" aria-hidden="true" />
				<span
					class="pointer-events-none absolute inset-x-0 mx-auto w-fit max-w-[60%] truncate rounded-sm border border-border bg-bg px-2.5 py-0.5 font-mono text-2xs text-fg-subtle"
					aria-hidden="true"
				>
					{chromeLabel}
				</span>
				<span class="snapshot-badge ml-auto font-mono text-2xs tracking-[0.16em] text-warning uppercase">
					Cached copy
				</span>
			</div>
		)}
		<div
			class:list={['demo-viewport relative', kind === 'phone' && 'rounded-[1.125rem]']}
			style={`aspect-ratio: ${native.w} / ${native.h}; --demo-native-w: ${native.w}px; --demo-native-h: ${native.h}px;`}
		>
			<iframe
				src={initialSrc}
				title={title}
				loading="lazy"
				data-live-src={src}
				data-snapshot-src={snapshot}
				data-snapshot-dark-src={darkSnapshot}
				data-themed={themed ? '' : undefined}
				width={native.w}
				height={native.h}
				inert={href ? true : undefined}
				sandbox={href ? 'allow-scripts allow-same-origin' : undefined}
				class:list={[!href && 'demo-interactive']}
			></iframe>
			{href && (
				<a
					href={href}
					class="demo-overlay"
					aria-label={hrefLabel ?? title}
					target={external ? '_blank' : undefined}
					rel={external ? 'noopener noreferrer' : undefined}
				/>
			)}
			{kind === 'phone' && (
				<span class="snapshot-badge absolute top-2 left-1/2 -translate-x-1/2 rounded-sm border border-border bg-bg px-2 py-0.5 font-mono text-2xs tracking-[0.16em] text-warning uppercase">
					Cached copy
				</span>
			)}
		</div>
	</div>
</figure>

<style>
	.demo-viewport {
		container-type: inline-size;
		overflow: hidden;
		background: var(--color-bg-elevated);
	}

	.demo-viewport iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--demo-native-w);
		height: var(--demo-native-h);
		border: 0;
		transform-origin: 0 0;
		/* Scale = container width / native width. tan(atan2(a, b)) divides two */
		/* lengths into a unitless ratio; --demo-scale is only set by the JS */
		/* fallback for browsers without CSS trig support. */
		transform: scale(var(--demo-scale, tan(atan2(100cqw, var(--demo-native-w)))));
		pointer-events: none;
	}

	.demo-viewport iframe.demo-interactive {
		pointer-events: auto;
	}

	.demo-overlay {
		position: absolute;
		inset: 0;
	}

	/* .demo-viewport clips overflow, so the global ring would be cut off outside the frame. */
	.demo-overlay:focus-visible {
		outline-offset: -3px;
	}

	.snapshot-badge {
		display: none;
	}

	.demo-frame.is-snapshot .snapshot-badge {
		display: inline-flex;
	}
</style>

<script>
	import { themedUrl, type DemoTheme } from '../lib/demos';

	// Reachability probe, one per unique live URL. The demo sites let this origin
	// read their demo responses (CORS), so a 404 or 500 counts as down, not only
	// a network failure. When the CORS read itself fails, an opaque no-cors probe
	// tells "host answered" from "host unreachable"; it cannot see the status,
	// so a demo without the CORS grant is judged by reachability alone.
	const PROBE: RequestInit = { method: 'HEAD', cache: 'no-store' };
	const probe = async (url: string): Promise<boolean> => {
		try {
			const res = await fetch(url, { ...PROBE, mode: 'cors', signal: AbortSignal.timeout(5000) });
			return res.ok;
		} catch (err) {
			if (err instanceof DOMException && err.name === 'TimeoutError') return false;
			try {
				await fetch(url, { ...PROBE, mode: 'no-cors', signal: AbortSignal.timeout(5000) });
				return true;
			} catch {
				return false;
			}
		}
	};
	const probes = new Map<string, Promise<boolean>>();
	const isUp = (url: string): Promise<boolean> => {
		let result = probes.get(url);
		if (!result) {
			result = probe(url);
			probes.set(url, result);
		}
		return result;
	};

	const siteTheme = (): DemoTheme =>
		document.documentElement.classList.contains('light') ? 'light' : 'dark';

	/** The URL a frame should show for the current site theme. */
	const frameSrc = (iframe: HTMLIFrameElement, theme: DemoTheme): string | undefined => {
		const { liveSrc, snapshotSrc, snapshotDarkSrc } = iframe.dataset;
		const themed = iframe.dataset.themed !== undefined;
		if (iframe.dataset.showing === 'snapshot') {
			return themed && theme === 'dark' ? (snapshotDarkSrc ?? snapshotSrc) : snapshotSrc;
		}
		return liveSrc && themed ? themedUrl(liveSrc, theme) : liveSrc;
	};

	const show = (iframe: HTMLIFrameElement, theme: DemoTheme) => {
		const next = frameSrc(iframe, theme);
		// Reassigning an unchanged src would reload the frame for nothing.
		if (next && iframe.src !== new URL(next, location.href).href) iframe.src = next;
	};

	const frames = [...document.querySelectorAll<HTMLIFrameElement>('iframe[data-live-src]')];
	let theme = siteTheme();
	for (const iframe of frames) {
		if (iframe.dataset.themed !== undefined) show(iframe, theme);
		const live = iframe.dataset.liveSrc;
		if (!live || !iframe.dataset.snapshotSrc) continue;
		void isUp(live).then((up) => {
			if (up) return;
			// Snapshots are served from our own origin, so an empty sandbox (no
			// scripts, unique origin) keeps captured third-party HTML from acting
			// as rogadigital.com. Set before src so the first load is sandboxed.
			iframe.setAttribute('sandbox', '');
			iframe.dataset.showing = 'snapshot';
			show(iframe, siteTheme());
			iframe.closest('[data-demo-frame]')?.classList.add('is-snapshot');
		});
	}

	// The theme toggle flips html.light; other class changes (the cross-fade)
	// leave the theme alone and are skipped.
	const themedFrames = frames.filter((iframe) => iframe.dataset.themed !== undefined);
	if (themedFrames.length > 0) {
		new MutationObserver(() => {
			const next = siteTheme();
			if (next === theme) return;
			theme = next;
			for (const iframe of themedFrames) show(iframe, theme);
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>
