---
/**
 * PacelineDemo: a mock Claude Code terminal that plays paceline's demo
 * scenes. Every status line, reply, prompt, and caption comes from
 * `src/data/paceline-scenes.json`, which paceline's `tools/demo` generates by
 * running its real renderer, so the demo cannot drift from what paceline
 * prints. Nothing here is hand-typed.
 *
 * Each scene's steps play in order for their `durationMs`, then the next
 * scene starts, and the scenes loop. Every step is rendered as HTML and
 * stacked in one grid cell, so without JavaScript the first step of the first
 * scene shows, and the terminal is always as tall as its tallest step (no
 * layout shift). The script only switches which step is current.
 *
 * Colors come from the JSON palette. Any text color under 4.5:1 on the
 * terminal background is lightened toward white, 1% at a time, until it
 * passes. With the current palette that changes dim #767676 to #7a7a7a and
 * the muted red #b92f2f to #c65757; every other color passes as is.
 */
import scenesData from '../../data/paceline-scenes.json';

/** One styled piece of a status line, as paceline's ANSI output parsed it. */
interface Run {
	text: string;
	/** A palette key (`cyan`, `green`, ...) or a `#rrggbb` truecolor value. */
	color?: string;
	dim?: boolean;
	bold?: boolean;
}

interface StatusLine {
	plain: string;
	runs: Run[];
}

interface Subagent {
	name: string;
	task?: string;
}

interface Step {
	durationMs: number;
	reply?: string;
	spinner?: { verb: string; activity: string };
	prompt?: string;
	modeLine?: string;
	subagents?: Subagent[];
	statusLines: StatusLine[];
}

interface Scene {
	id: string;
	title: string;
	caption: string;
	/** `terminal` (Claude Code chrome) or `windows` (stacked status lines). */
	layout: string;
	durationMs: number;
	steps: Step[];
}

interface ScenesFile {
	palette: Record<string, string>;
	scenes: Scene[];
}

/** A run ready to render: its text and an inline style, when it needs one. */
interface RunView {
	text: string;
	style?: string;
}

/** A status-line segment: the runs between two dim `·` separators. */
interface SegmentView {
	runs: RunView[];
	/** True when the segment is new or its text differs from the previous step. */
	changed: boolean;
}

interface StepView {
	scene: number;
	index: number;
	durationMs: number;
	layout: string;
	reply?: string;
	spinner?: { verb: string; activity: string };
	prompt: string;
	/** True when the prompt is new in this step, so the script types it out. */
	typePrompt: boolean;
	modeLine?: string;
	subagents: Subagent[];
	lines: SegmentView[][];
}

const data: ScenesFile = scenesData;
const { palette, scenes } = data;
const MIN_CONTRAST = 4.5;

const toRgb = (hex: string): number[] =>
	[1, 3, 5].map((start) => parseInt(hex.slice(start, start + 2), 16));

const luminance = (hex: string): number => {
	const [r, g, b] = toRgb(hex).map((channel) => {
		const c = channel / 255;
		return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
	});
	return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};

const contrast = (a: string, b: string): number => {
	const [la, lb] = [luminance(a), luminance(b)];
	return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
};

/** Lightens `hex` toward white just enough to reach 4.5:1 on the terminal. */
function readable(hex: string): string {
	const rgb = toRgb(hex);
	for (let percent = 0; percent <= 100; percent++) {
		const mixed = `#${rgb
			.map((c) =>
				Math.round(c + ((255 - c) * percent) / 100)
					.toString(16)
					.padStart(2, '0'),
			)
			.join('')}`;
		if (contrast(mixed, palette.background) >= MIN_CONTRAST) return mixed;
	}
	return '#ffffff';
}

const dimColor = readable(palette.dim);

/** The CSS color for a run; undefined means the terminal's foreground. */
function runColor(run: Run): string | undefined {
	if (run.dim) return dimColor;
	if (!run.color) return undefined;
	const value = run.color.startsWith('#') ? run.color : palette[run.color];
	return readable(value ?? palette.foreground);
}

function toRunView(run: Run): RunView {
	const color = runColor(run);
	const style = [color && `color: ${color}`, run.bold && 'font-weight: 700']
		.filter(Boolean)
		.join('; ');
	return { text: run.text, style: style || undefined };
}

/**
 * Splits a status line into segments at its dim `·` separators and trims the
 * whitespace at each segment's edges (paceline pads around the separator, and
 * the progress segment's first run is `" loop "`).
 */
function splitSegments(line: StatusLine): Run[][] {
	const groups: Run[][] = [[]];
	for (const run of line.runs) {
		if (run.dim && run.text === '·') groups.push([]);
		else groups[groups.length - 1].push({ ...run });
	}
	return groups
		.map((group) => {
			while (group.length > 0) {
				group[0].text = group[0].text.trimStart();
				if (group[0].text !== '') break;
				group.shift();
			}
			while (group.length > 0) {
				const last = group[group.length - 1];
				last.text = last.text.trimEnd();
				if (last.text !== '') break;
				group.pop();
			}
			return group;
		})
		.filter((group) => group.length > 0);
}

const plainOf = (runs: Run[]): string => runs.map((run) => run.text).join('');

const steps: StepView[] = scenes.flatMap((scene, sceneIndex) =>
	scene.steps.map((step, index) => {
		const previous = index > 0 ? scene.steps[index - 1] : undefined;
		const prompt = step.prompt ?? '';
		return {
			scene: sceneIndex,
			index,
			durationMs: step.durationMs,
			layout: scene.layout,
			reply: step.reply,
			spinner: step.spinner,
			prompt,
			typePrompt: prompt !== '' && prompt !== previous?.prompt,
			modeLine: step.modeLine,
			subagents: step.subagents ?? [],
			lines: step.statusLines.map((line, lineIndex) => {
				const before = previous?.statusLines[lineIndex];
				const beforeTexts = before ? splitSegments(before).map(plainOf) : [];
				return splitSegments(line).map((runs, k) => ({
					runs: runs.map(toRunView),
					changed: plainOf(runs) !== beforeTexts[k],
				}));
			}),
		};
	}),
);

const terminalVars = [
	`--term-bg: ${palette.background}`,
	`--term-fg: ${readable(palette.foreground)}`,
	`--term-dim: ${dimColor}`,
	`--term-reply: ${readable(palette.reply)}`,
	`--term-spinner: ${readable(palette.spinner)}`,
	`--term-rule: ${palette.promptRule}`,
	`--term-mode: ${readable(palette.modeLine)}`,
].join('; ');
---

<figure class="paceline-demo not-prose" data-paceline-demo>
	<div class="overflow-hidden rounded-lg border border-border">
		<div class="terminal font-mono text-xs leading-relaxed sm:text-sm" style={terminalVars}>
			{steps.map((step) => (
				<div
					class="step"
					data-step
					data-scene={step.scene}
					data-ms={step.durationMs}
					data-current={step.scene === 0 && step.index === 0 ? '' : undefined}
				>
					{step.layout === 'windows' ? (
						step.lines.map((segments, n) => (
							<div class="window">
								<p class="status">
									<span class="sr-only">{`Window ${n + 1} status line: `}</span>
									{segments.map((seg, k) => (
										<>
											{k > 0 && (
												<>
													{' '}
													<span class="t-dim">·</span>{' '}
												</>
											)}
											<span class:list={['seg', seg.changed && 'changed']}>
												{seg.runs.map((run) => (
													<span style={run.style}>{run.text}</span>
												))}
											</span>
										</>
									))}
								</p>
							</div>
						))
					) : (
						<>
							<p class="line row reply" aria-hidden="true">
								<span class="glyph t-reply">●</span>
								<span>{step.reply}</span>
							</p>
							<p class="line row activity" aria-hidden="true">
								{step.spinner ? (
									<>
										<span class="glyph spinner">✻</span>
										<span>
											<span class="t-spinner">{step.spinner.verb}&hellip;</span>{' '}
											<span class="t-dim">({step.spinner.activity})</span>
										</span>
									</>
								) : (
									<span>&nbsp;</span>
								)}
							</p>
							<div class="prompt row" aria-hidden="true">
								<span class="glyph">&gt;</span>
								<span>
									<span data-typed={step.typePrompt ? step.prompt : undefined}>{step.prompt}</span>
									<span class="cursor" />
								</span>
							</div>
							{step.lines.map((segments) => (
								<p class="line status">
									<span class="sr-only">Status line: </span>
									{segments.map((seg, k) => (
										<>
											{k > 0 && (
												<>
													{' '}
													<span class="t-dim">·</span>{' '}
												</>
											)}
											<span class:list={['seg', seg.changed && 'changed']}>
												{seg.runs.map((run) => (
													<span style={run.style}>{run.text}</span>
												))}
											</span>
										</>
									))}
								</p>
							))}
							{step.modeLine && (
								<p class="line indent t-mode" aria-hidden="true">
									{step.modeLine}
								</p>
							)}
							{step.subagents.length > 0 && (
								<ul class="subagents" aria-hidden="true">
									{step.subagents.map((agent, k) =>
										k === 0 ? (
											<li class="row">
												<span class="glyph t-reply">●</span>
												<span>{agent.name}</span>
											</li>
										) : (
											<li class="row">
												<span class="glyph wide t-dim">( )</span>
												<span>
													{agent.name}
													{agent.task && (
														<>
															{' '}
															<span class="t-dim">{agent.task}</span>
														</>
													)}
												</span>
											</li>
										),
									)}
								</ul>
							)}
						</>
					)}
				</div>
			))}
		</div>
	</div>

	<div class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Paceline scenarios">
		{scenes.map((scene, i) => (
			<button
				type="button"
				data-pick={i}
				aria-pressed={i === 0 ? 'true' : 'false'}
				class="pick min-h-11 rounded-sm border border-border px-3 text-sm text-fg-muted transition-colors hover:border-border-strong hover:text-fg"
			>
				{scene.title}
			</button>
		))}
		<div class="ml-auto hidden items-center gap-3" data-controls>
			<span class="countdown" aria-hidden="true">
				<span class="countdown-fill" data-countdown></span>
			</span>
			<button
				type="button"
				data-toggle
				class="min-h-11 min-w-[4.5rem] rounded-sm border border-border px-3 text-sm font-medium text-fg transition-colors hover:border-border-strong hover:bg-bg-elevated"
			>
				Pause
			</button>
		</div>
	</div>

	<figcaption class="mt-4 min-h-[4.5em] max-w-2xl text-fg-muted text-pretty" aria-live="polite">
		{scenes.map((scene, i) => (
			<span data-caption={i} hidden={i !== 0}>
				{scene.caption}
			</span>
		))}
	</figcaption>
</figure>

<style>
	/* A terminal is dark in both site themes, like the real thing. Its colors
	   are set inline from the JSON palette (see the frontmatter). */
	.terminal {
		display: grid;
		background: var(--term-bg);
		color: var(--term-fg);
		padding: 1.25rem 1rem 1rem;
		overflow-wrap: anywhere;
	}

	@media (min-width: 40rem) {
		.terminal {
			padding: 1.5rem;
		}
	}

	/* Every step shares one grid cell, so the terminal keeps the height of the
	   tallest step and nothing jumps between scenes. Only the current step is
	   visible; the others are hidden from sight and from screen readers. */
	.step {
		grid-area: 1 / 1;
		min-width: 0;
	}

	.step:not([data-current]) {
		visibility: hidden;
	}

	.line,
	.subagents {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* A glyph column with a hanging indent, so wrapped text lines up after it. */
	.row {
		display: flex;
	}

	.glyph {
		flex: none;
		width: 2ch;
	}

	.glyph.wide {
		width: 4ch;
	}

	.reply,
	.activity {
		margin-bottom: 1.625em;
	}

	.prompt {
		margin-bottom: 0.75em;
		padding: 0.5em 0;
		border-block: 1px solid var(--term-rule);
	}

	.status,
	.indent,
	.subagents {
		padding-left: 2ch;
	}

	.window {
		padding-top: 0.5em;
		border-top: 1px solid var(--term-rule);
	}

	.window + .window {
		margin-top: 1.625em;
	}

	/* Segments wrap as whole units on narrow screens, never mid-segment. */
	.seg {
		white-space: nowrap;
	}

	.step[data-current] .seg.changed {
		animation: rise 0.45s ease-out both;
	}

	.spinner {
		color: var(--term-spinner);
		animation: pulse 1.6s ease-in-out infinite;
	}

	.cursor {
		display: inline-block;
		width: 1ch;
		height: 1.2em;
		vertical-align: text-bottom;
		background: var(--term-fg);
		animation: blink 1.1s steps(1) infinite;
	}

	.t-dim {
		color: var(--term-dim);
	}
	.t-reply {
		color: var(--term-reply);
	}
	.t-spinner {
		color: var(--term-spinner);
	}
	.t-mode {
		color: var(--term-mode);
	}

	.countdown {
		display: block;
		width: 4rem;
		height: 3px;
		overflow: hidden;
		border-radius: 9999px;
		background: var(--color-border);
	}

	.countdown-fill {
		display: block;
		height: 100%;
		background: var(--color-fg-muted);
		transform: scaleX(0);
		transform-origin: left;
	}

	.pick[aria-pressed='true'] {
		border-color: var(--color-fg);
		color: var(--color-fg);
	}

	@keyframes rise {
		from {
			opacity: 0.15;
			transform: translateY(3px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.spinner,
		.cursor,
		.step[data-current] .seg.changed {
			animation: none;
		}
	}
</style>

<script>
	const TYPE_MS = 45;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const root of document.querySelectorAll<HTMLElement>('[data-paceline-demo]')) {
		const stepEls = [...root.querySelectorAll<HTMLElement>('[data-step]')];
		const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
		const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
		const controls = root.querySelector<HTMLElement>('[data-controls]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
		const countdown = root.querySelector<HTMLElement>('[data-countdown]');
		if (!controls || !toggle || !countdown || stepEls.length === 0) continue;

		// Steps grouped by scene, with each step's duration in milliseconds.
		const scenes: HTMLElement[][] = [];
		for (const el of stepEls) (scenes[Number(el.dataset.scene)] ??= []).push(el);
		const durations = scenes.map((steps) => steps.map((el) => Number(el.dataset.ms)));

		let scene = 0;
		let current = stepEls.find((el) => el.hasAttribute('data-current'));
		let playing = false;
		// Reduced motion shows a picked scene's last step until Play is pressed.
		let showingFinal = false;
		let bar: Animation | undefined;
		let stepTimer: number | undefined;
		let typing: number | undefined;
		let typed: { el: HTMLElement; text: string } | undefined;

		const finishTyping = () => {
			window.clearInterval(typing);
			if (typed) typed.el.textContent = typed.text;
			typed = undefined;
		};

		// Types a new prompt one character at a time, fast enough to finish
		// within the step, as if someone is writing while the assistant works.
		const typePrompt = (step: HTMLElement, ms: number) => {
			const el = step.querySelector<HTMLElement>('[data-typed]');
			const text = el?.dataset.typed;
			if (!el || !text) return;
			typed = { el, text };
			let length = 0;
			el.textContent = '';
			typing = window.setInterval(
				() => {
					length += 1;
					el.textContent = text.slice(0, length);
					if (length >= text.length) finishTyping();
				},
				Math.min(TYPE_MS, (ms * 0.8) / text.length),
			);
		};

		const showStep = (index: number) => {
			const next = scenes[scene][index];
			finishTyping();
			current?.removeAttribute('data-current');
			next.setAttribute('data-current', '');
			current = next;
			if (playing && !reduceMotion) typePrompt(next, durations[scene][index]);
		};

		// The countdown bar's animation is the clock: its current time picks
		// the step, so pausing the bar freezes the steps too.
		const elapsed = () => {
			const time = bar?.currentTime;
			return typeof time === 'number' ? time : 0;
		};

		const sync = () => {
			window.clearTimeout(stepTimer);
			if (!playing) return;
			const time = elapsed();
			const steps = durations[scene];
			let index = 0;
			let end = steps[0];
			while (index < steps.length - 1 && time >= end) {
				index += 1;
				end += steps[index];
			}
			if (showingFinal || current !== scenes[scene][index]) {
				showingFinal = false;
				showStep(index);
			}
			if (index < steps.length - 1) stepTimer = window.setTimeout(sync, end - time);
		};

		const startScene = (index: number, final: boolean) => {
			window.clearTimeout(stepTimer);
			scene = index;
			captions.forEach((el, i) => (el.hidden = i !== index));
			picks.forEach((el, i) => el.setAttribute('aria-pressed', String(i === index)));

			bar?.cancel();
			bar = countdown.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
				duration: durations[index].reduce((sum, ms) => sum + ms, 0),
				easing: 'linear',
				fill: 'forwards',
			});
			bar.onfinish = () => startScene((scene + 1) % scenes.length, false);
			if (!playing) bar.pause();

			showingFinal = final;
			showStep(final ? durations[index].length - 1 : 0);
			sync();
		};

		const setPlaying = (next: boolean) => {
			playing = next;
			toggle.textContent = next ? 'Pause' : 'Play';
			if (next) {
				bar?.play();
				sync();
			} else {
				bar?.pause();
				window.clearTimeout(stepTimer);
				finishTyping();
			}
		};

		picks.forEach((el, i) =>
			el.addEventListener('click', () => {
				setPlaying(false);
				startScene(i, reduceMotion);
			}),
		);
		toggle.addEventListener('click', () => setPlaying(!playing));
		controls.classList.replace('hidden', 'flex');

		// Reduced motion starts paused on the first scene's last step, with no
		// typing or decorative animation; Play still steps through every scene.
		playing = !reduceMotion;
		toggle.textContent = playing ? 'Pause' : 'Play';
		startScene(0, reduceMotion);
	}
</script>
