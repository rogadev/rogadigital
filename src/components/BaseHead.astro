---
import '../styles/global.css';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { deriveOgPath } from '../lib/og-path';

interface Props {
	title: string;
	description: string;
	/** Override the auto-derived OG image path. Should be absolute (starts with /). */
	ogPath?: string;
	noindex?: boolean;
	/** `article` for insight posts and case studies; `website` for everything else. */
	ogType?: 'website' | 'article';
	/** Article publish/update times. Only meaningful when ogType is `article`. */
	publishedTime?: Date;
	modifiedTime?: Date;
	/** schema.org objects, serialised into <script type="application/ld+json">. */
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	ogPath,
	noindex = false,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
} = Astro.props;

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// OG endpoint selection (deriveOgPath) and the page-OG copy it depends on
// (STATIC_PAGE_OGS) live in `src/lib/og-path.ts` / `src/lib/og-pages.ts` —
// a single source shared with the `/og/[page].png` endpoint, so the two
// can't disagree. See tests/og-coverage.test.ts.
const ogImageUrl = new URL(ogPath ?? deriveOgPath(Astro.url.pathname), Astro.site);
---

<!-- Charset / viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<!-- Icons / manifest -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/logo/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />

<!-- Sitemap / RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary meta -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogType === 'article' && (
	<>
		{publishedTime && (
			<meta property="article:published_time" content={publishedTime.toISOString()} />
		)}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		<meta property="article:author" content={SITE_AUTHOR} />
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured data -->
{schemas.map((schema) => (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
))}
